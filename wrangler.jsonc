{
  "name": "impact-gate-site",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "impactgate.in", "custom_domain": true },
    { "pattern": "www.impactgate.in", "custom_domain": true }
  ],
  "main": "./src/worker.ts"
}
