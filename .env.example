# Cloudflare Stream configuration. Keep real values in .env; do not commit them.
PUBLIC_STREAM_CUSTOMER_CODE=
PUBLIC_STREAM_VIDEO_UID_HOW_IT_WORKS=
PUBLIC_STREAM_VIDEO_UID_IMPACT=
# Local Vite development API origin (the browser still uses /api/v1).
IMPACT_GATE_API_ORIGIN=http://127.0.0.1:3000
# Production: set IMPACT_GATE_API_ORIGIN as a Cloudflare Worker variable to the fixed HTTPS backend origin.
# Firebase public web configuration is served by backend /api/v1/config.
# Website Analytics uses the public SDK config in src/analytics/firebase-config.json.
# It is separate from authentication config and includes measurementId; no server key is bundled.
# Analytics is disabled outside impactgate.in unless session debug mode is explicitly enabled.
# GitHub App PUBLIC_API_URL must be the site origin, so the OAuth nonce cookie returns through this proxy.
