---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import HowItWorks from "../components/HowItWorks.astro";
import EvidenceDemo from "../components/EvidenceDemo.astro";
import EvidenceStates from "../components/EvidenceStates.astro";
import SupportedChanges from "../components/SupportedChanges.astro";
import ModelModes from "../components/ModelModes.astro";
import Lifecycle from "../components/Lifecycle.astro";
import HonestLimits from "../components/HonestLimits.astro";
import PilotForm from "../components/PilotForm.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import VideoFacade from "../components/VideoFacade.astro";
import siteFacts from "../data/site-facts.json";
const streamCustomerCode = import.meta.env.PUBLIC_STREAM_CUSTOMER_CODE ?? "";
const howItWorksUid = import.meta.env.PUBLIC_STREAM_VIDEO_UID_HOW_IT_WORKS ?? "";
const impactUid = import.meta.env.PUBLIC_STREAM_VIDEO_UID_IMPACT ?? "";
---
<BaseLayout>
  <Header />
  <main>
    <Hero />
    <ProblemSection />
    <section class="video-section video-impact">
      <div class="container">
        <div class="section-heading"><span class="eyebrow">{siteFacts.videos.impactLabel}</span><h2>{siteFacts.videos.impactTitle}</h2><p>{siteFacts.videos.impactCopy}</p></div>
        <VideoFacade title={siteFacts.videos.impactTitle} caption={siteFacts.videos.impactCaption} uid={impactUid} customerCode={streamCustomerCode} />
      </div>
    </section>
    <HowItWorks />
    <section class="video-section video-how" id="how-it-works-video">
      <div class="container">
        <div class="section-heading"><span class="eyebrow">{siteFacts.videos.howLabel}</span><h2>{siteFacts.videos.howTitle}</h2><p>{siteFacts.videos.howCopy}</p></div>
        <VideoFacade title={siteFacts.videos.howTitle} caption={siteFacts.videos.howCaption} uid={howItWorksUid} customerCode={streamCustomerCode} />
      </div>
    </section>
    <EvidenceDemo />
    <EvidenceStates />
    <SupportedChanges />
    <ModelModes />
    <Lifecycle />
    <HonestLimits />
    <PilotForm />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
<style>
  .video-section { padding: var(--space-16) 0; border-bottom: 1px solid var(--color-border); background: var(--color-background); }
  .video-how { background: var(--color-surface); }
</style>
