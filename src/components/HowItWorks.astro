---
import Fact from "./Fact.astro";
import siteFacts from "../data/site-facts.json";
const steps = [
  ["01", "Read the contract diff", "The review starts with the API contract change in the pull request."],
  ["02", "Find indexed callers", "The graph connects the changed endpoint to downstream services in the connected codebase."],
  ["03", "Trace consumer code", "Static analysis follows the consumer path and keeps evidence attached to the review."],
  ["04", "Post a warn-only comment", "The result is presented for human review and does not block a merge."]
];
---
<section class="section how" id="how-it-works">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Architecture and mechanics</span>
      <h2>From contract change to reviewable evidence.</h2>
      <p>{siteFacts.mechanism.copy}</p>
    </div>
    <div class="steps">{steps.map(([number, title, copy]) => <article><span class="step-number">{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
    <div class="fact-row"><Fact status={siteFacts.warnOnly.status} label={siteFacts.warnOnly.label} copy={siteFacts.warnOnly.copy} /><Fact status={siteFacts.analysis.status} label={siteFacts.analysis.label} copy={siteFacts.analysis.copy} /></div>
  </div>
</section>
<style>
  .how { background: var(--color-surface); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: var(--space-12); border: 1px solid var(--color-border); background: var(--color-border); }
  .steps article { min-height: 14rem; padding: var(--space-5); background: var(--color-surface); }
  .step-number { color: var(--color-primary); font: 700 var(--text-xs)/1 var(--font-mono); }
  .steps h3 { font-size: var(--text-lg); } .steps p { color: var(--color-secondary); line-height: 1.6; }
  .fact-row { display: flex; flex-wrap: wrap; gap: var(--space-6); margin-top: var(--space-8); }
  @media (max-width: 48rem) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 32rem) { .steps { grid-template-columns: 1fr; } }
</style>
