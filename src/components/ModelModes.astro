---
import Fact from "./Fact.astro";
import siteFacts from "../data/site-facts.json";
---
<section class="section model">
  <div class="container model-grid">
    <div class="section-heading"><span class="eyebrow">Privacy and determinism</span><h2>Deterministic core by default.</h2><p>{siteFacts.model.copy}</p></div>
    <div class="mode-card"><Fact status={siteFacts.analysis.status} label="Core mode" /><h3>Static consumer tracing</h3><ul><li>Reads the contract change.</li><li>Maps callers in the connected graph.</li><li>Keeps the evidence path visible.</li><li>Leaves merge control with the team.</li></ul></div>
    <div class="mode-card muted-card"><Fact status={siteFacts.model.status} label="Optional add-on" /><h3>Model-assisted explanations</h3><p>{siteFacts.model.copy}</p></div>
  </div>
</section>
<style>
  .model { background: var(--color-surface); } .model-grid { display: grid; grid-template-columns: 1.1fr .9fr .9fr; gap: var(--space-6); align-items: start; }
  .mode-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-background); }
  .mode-card h3 { margin: var(--space-8) 0 var(--space-4); } .mode-card ul { margin: 0; padding-left: 1.1rem; color: var(--color-secondary); line-height: 2; } .mode-card p { color: var(--color-secondary); line-height: 1.6; }
  .muted-card { background: var(--color-surface-muted); }
  @media (max-width: 52rem) { .model-grid { grid-template-columns: 1fr 1fr; } .model-grid .section-heading { grid-column: 1 / -1; } } @media (max-width: 36rem) { .model-grid { grid-template-columns: 1fr; } }
</style>
