---
import BrandMark from "./BrandMark.astro";
---
<header class="header">
  <div class="container nav-wrap">
    <BrandMark />
    <nav aria-label="Primary">
      <a href="#how-it-works">How it works</a>
      <a href="#evidence">Evidence states</a>
      <a href="#changes">Supported changes</a>
      <a href="#limits">Limits</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="nav-cta" href="#pilot">Join the private pilot</a>
  </div>
</header>
<style>
  .header { background: var(--color-navy); color: white; }
  .nav-wrap { display: flex; align-items: center; gap: var(--space-8); min-height: 4.5rem; }
  nav { display: flex; gap: var(--space-6); margin-inline: auto; color: #dbe2ed; font-size: var(--text-sm); }
  nav a { display: inline-flex; align-items: center; text-decoration: none; }
  nav a:hover, nav a:focus-visible { color: var(--color-action); }
  .nav-cta { display: inline-flex; align-items: center; justify-content: center; padding: 0 var(--space-4); border-radius: var(--radius-sm); background: var(--color-action); color: var(--color-navy); font-size: var(--text-sm); font-weight: 700; text-decoration: none; }
  @media (max-width: 60rem) { nav { display: none; } .nav-cta { margin-left: auto; } }
  @media (max-width: 36rem) { .nav-cta { padding-inline: var(--space-3); font-size: var(--text-xs); } }
</style>
