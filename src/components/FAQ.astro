---
const items = [
  ["How does the pilot access code?", "The site is preparing a private pilot. Access details will be shared with accepted waitlist participants."],
  ["Does the review block a merge?", "The current product fact is warn-only: the review presents information and does not block a merge."],
  ["What does the default mode do?", "The default promise is a deterministic core that reads the contract change and traces connected consumer code."],
  ["What if tracing cannot establish an answer?", "The uncertainty remains visible instead of being presented as a clean result."]
];
---
<section class="section faq" id="faq">
  <div class="container">
    <div class="section-heading"><span class="eyebrow">Frequently asked questions</span><h2>Direct answers on operation.</h2></div>
    <div class="faq-list">{items.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
  </div>
</section>
<style>
  .faq { background: var(--color-background); } .faq-list { max-width: 52rem; margin-top: var(--space-10); } details { border-top: 1px solid var(--color-border); } details:last-child { border-bottom: 1px solid var(--color-border); } summary { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-5) 0; color: var(--color-navy); cursor: pointer; font-size: var(--text-lg); font-weight: 700; list-style: none; } summary::-webkit-details-marker { display: none; } summary span { color: var(--color-primary); font-size: var(--text-2xl); font-weight: 400; } details[open] summary span { transform: rotate(45deg); } details p { max-width: 44rem; margin: 0 0 var(--space-5); color: var(--color-secondary); line-height: 1.65; }
</style>
