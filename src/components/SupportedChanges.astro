---
import Fact from "./Fact.astro";
import siteFacts from "../data/site-facts.json";
const changes = [
  ["Type changes", "Response or request types that change the assumptions a consumer must make."],
  ["Required fields", "New required inputs that existing callers may not provide."],
  ["Field removal or rename", "Removed or renamed fields that consumer code may still read."],
  ["Enum changes", "Contract value changes that need review in callers."],
  ["Status changes", "Documented response status changes that alter client handling."]
];
---
<section class="section" id="changes">
  <div class="container">
    <div class="section-heading"><span class="eyebrow">Scope of analysis</span><h2>Supported contract changes.</h2><p>{siteFacts.contract.copy}</p></div>
    <div class="change-list">{changes.map(([title, copy]) => <article><div><h3>{title}</h3><Fact status={siteFacts.contract.status} label="OpenAPI" compact /></div><p>{copy}</p></article>)}</div>
  </div>
</section>
<style>
  .change-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-3); margin-top: var(--space-12); }
  .change-list article { min-height: 12rem; padding: var(--space-4); border: 1px solid var(--color-border); background: var(--color-surface); }
  .change-list h3 { margin: 0 0 var(--space-4); font-size: var(--text-lg); } .change-list p { color: var(--color-secondary); font-size: var(--text-sm); line-height: 1.5; }
  @media (max-width: 60rem) { .change-list { grid-template-columns: repeat(3, 1fr); } } @media (max-width: 42rem) { .change-list { grid-template-columns: 1fr 1fr; } } @media (max-width: 30rem) { .change-list { grid-template-columns: 1fr; } }
</style>
