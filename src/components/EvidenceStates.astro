---
import Fact from "./Fact.astro";
import siteFacts from "../data/site-facts.json";
const states = [
  ["VERIFIED BREAK", "Evidence found", "The trace has a deterministic code path that requires review.", "available"],
  ["POSSIBLE", "Requires review", "The caller is known, but the available trace does not establish a definitive result.", "in_testing"],
  ["NOT AFFECTED", "No changed field access", "The connected code path does not access the changed field.", "available"],
  ["UNINDEXED", "Coverage gap", "A caller or repository is known but the connected source is incomplete.", "in_testing"]
];
---
<section class="section" id="evidence">
  <div class="container">
    <div class="section-heading"><span class="eyebrow">Standard classification</span><h2>Evidence states that keep triage honest.</h2><p>{siteFacts.policy.copy}</p></div>
    <div class="state-grid">{states.map(([badge, title, copy, status]) => <article class:list={[badge.toLowerCase().replace(" ", "-")]}><div class="state-head"><span>{badge}</span><Fact status={status as "available" | "in_testing"} label={title} compact /></div><h3>{title}</h3><p>{copy}</p></article>)}</div>
  </div>
</section>
<style>
  .state-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin-top: var(--space-12); }
  .state-grid article { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .state-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .state-head > span { color: var(--color-primary); font: 700 var(--text-xs)/1 var(--font-mono); letter-spacing: .08em; }
  .state-grid h3 { margin-top: var(--space-8); } .state-grid p { color: var(--color-secondary); line-height: 1.6; }
  .verified-break { border-top: 3px solid var(--color-action) !important; } .possible { border-top: 3px solid var(--color-gold) !important; }
  @media (max-width: 42rem) { .state-grid { grid-template-columns: 1fr; } }
</style>
