---
import Fact from "./Fact.astro";
import siteFacts from "../data/site-facts.json";
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="hero-facts">
        <Fact status={siteFacts.warnOnly.status} label={siteFacts.warnOnly.label} compact />
        <Fact status={siteFacts.stage.status} label={siteFacts.stage.label} compact />
      </div>
      <h1>{siteFacts.mechanism.copy.split(",")[0]}.</h1>
      <p class="hero-lede">A shared API can change in one pull request while its callers live across repositories. Impact Gate turns that cross-repository question into a reviewable evidence trail.</p>
      <div class="hero-actions">
        <a class="button primary" href="#pilot">Request pilot access</a>
        <a class="button secondary" href="#how-it-works-video">See how it works</a>
      </div>
    </div>
    <div class="hero-card" aria-label="Illustrative evidence card">
      <div class="card-top"><span class="mono">impact-gate[bot]</span><span class="muted">illustrative review</span></div>
      <div class="card-rule"></div>
      <div class="card-title"><span class="signal"></span><strong>Evidence trail</strong><span class="status">Warn-only</span></div>
      <div class="diff-line"><span class="minus">−</span><span>response.total</span><span class="muted">contract field</span></div>
      <div class="trace">
        <div><span class="trace-dot"></span><span>indexed caller</span></div>
        <div><span class="trace-dot gold"></span><span>usage requires review</span></div>
        <div><span class="trace-dot muted-dot"></span><span>uncertainty stays visible</span></div>
      </div>
      <p class="card-note">Illustrative structure only. The live site does not present synthetic findings as customer evidence.</p>
    </div>
  </div>
</section>
<style>
  .hero { background: var(--color-navy); color: white; padding: var(--space-16) 0 var(--space-20); border-bottom: 1px solid #243b5a; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: var(--space-16); align-items: center; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-8); color: #dbe2ed; }
  .hero h1 { max-width: 42rem; margin: 0; font: 700 var(--text-hero)/var(--leading-tight) var(--font-display); letter-spacing: -.03em; }
  .hero-lede { max-width: 38rem; margin: var(--space-6) 0 0; color: #c5d0df; font-size: var(--text-lg); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .button { display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); padding: 0 var(--space-5); text-decoration: none; font-size: var(--text-sm); font-weight: 700; }
  .button.primary { background: var(--color-action); color: var(--color-navy); }
  .button.secondary { border: 1px solid #7588a4; color: white; }
  .hero-card { padding: var(--space-6); border: 1px solid #38506f; border-radius: var(--radius-md); background: #132642; box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 16%); }
  .card-top, .card-title, .diff-line, .trace div { display: flex; align-items: center; gap: var(--space-3); }
  .card-top { justify-content: space-between; font-size: var(--text-xs); }
  .mono { font-family: var(--font-mono); color: #e4ebf4; }
  .muted { color: #9eacc0; }
  .card-rule { height: 1px; margin: var(--space-5) 0; background: #38506f; }
  .signal, .trace-dot { width: .65rem; height: .65rem; border-radius: 50%; background: var(--color-action); }
  .card-title { color: white; }
  .status { margin-left: auto; border: 1px solid #526e8d; border-radius: var(--radius-pill); padding: .25rem .55rem; color: var(--color-action); font: 700 var(--text-xs)/1 var(--font-mono); }
  .diff-line { margin-top: var(--space-6); padding: var(--space-3); border-radius: var(--radius-sm); background: #0d1e38; font-family: var(--font-mono); font-size: var(--text-xs); }
  .minus { color: #ffaeae; }
  .trace { display: grid; gap: var(--space-3); margin-top: var(--space-6); color: #dbe2ed; font-size: var(--text-sm); }
  .trace-dot.gold { background: var(--color-gold); } .trace-dot.muted-dot { background: #8fa1b8; }
  .card-note { margin: var(--space-6) 0 0; color: #9eacc0; font-size: var(--text-xs); line-height: 1.5; }
  @media (max-width: 52rem) { .hero-grid { grid-template-columns: 1fr; gap: var(--space-10); } .hero { padding-top: var(--space-12); } }
</style>
