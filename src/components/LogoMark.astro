---
interface Props {
  size?: number;
  width?: number;
  interactive?: boolean;
  animate?: boolean;
  label?: string;
}

const { size = 32, width = size, interactive = false, animate = true, label = "Impact Gate" } = Astro.props;
---
<svg
  class:list={["logo-mark", { interactive, animate }]}
  width={width}
  height={size}
  style={`width: ${width}px; height: ${size}px; flex: 0 0 auto;`}
  viewBox="0 0 100 100"
  role="img"
  aria-label={label}
  focusable="false"
>
  <g class="chevrons" aria-hidden="true">
    <path class="chevron chevron-left" d="M29 33 13 50l16 17" />
    <path class="chevron chevron-right" d="M71 33 87 50 71 67" />
  </g>
  <g class="bars" aria-hidden="true">
    <rect class="bar bar-left" x="35" y="28" width="8" height="44" rx="4" />
    <rect class="bar bar-right" x="57" y="28" width="8" height="44" rx="4" />
  </g>
  <g class="dots" aria-hidden="true">
    <circle class="dot dot-1" cx="25" cy="50" r="3" />
    <circle class="dot dot-2" cx="35" cy="50" r="3" />
    <circle class="dot dot-3 dot-mid" cx="45" cy="50" r="3" />
    <circle class="dot dot-4 dot-mid" cx="55" cy="50" r="3" />
    <circle class="dot dot-5" cx="65" cy="50" r="3" />
    <circle class="dot dot-6" cx="75" cy="50" r="3" />
  </g>
</svg>

<style>
  .logo-mark { display: block; overflow: visible; color: var(--logo-mark-ink); }
  .chevron { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 8; }
  .dot { fill: currentColor; transform-box: fill-box; transform-origin: center; }
  .dot-mid { fill: var(--brand-mark-green); }
  .bar { fill: var(--brand-mark-green); transform-box: fill-box; transform-origin: center; }
  .animate .dot { animation: logo-dot-pulse 2.8s cubic-bezier(.4, 0, .2, 1) infinite; }
  .animate .dot-2 { animation-delay: .12s; }
  .animate .dot-3 { animation-delay: .24s; }
  .animate .dot-4 { animation-delay: .36s; }
  .animate .dot-5 { animation-delay: .48s; }
  .animate .dot-6 { animation-delay: .6s; }
  .animate .bar { animation: logo-bar-breathe 4s cubic-bezier(.4, 0, .2, 1) infinite; }
  .animate .bar-right { animation-delay: 2s; }
  .interactive .chevron { transition: transform .18s ease; }
  .interactive:hover .chevron-left, .interactive:focus-visible .chevron-left { transform: translateX(-1.5px); }
  .interactive:hover .chevron-right, .interactive:focus-visible .chevron-right { transform: translateX(1.5px); }
  @keyframes logo-dot-pulse {
    0%, 100% { opacity: .45; transform: translateX(0) scale(.82); }
    18% { opacity: 1; transform: translateX(1px) scale(1.12); }
    34%, 100% { opacity: .45; transform: translateX(0) scale(.82); }
  }
  @keyframes logo-bar-breathe {
    0%, 100% { opacity: .85; transform: scaleY(.98); }
    45%, 65% { opacity: 1; transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate .dot, .animate .bar { animation: none; }
    .interactive .chevron { transition: none; }
  }
</style>
